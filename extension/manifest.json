{
  "manifest_version": 3,
  "name": "TruthGuard - Fake News Detector",
  "version": "1.0.0",
  "description": "Verifies the claims in the article you're reading against real evidence, in one click.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://truth-guard-acbi.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthGuard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
